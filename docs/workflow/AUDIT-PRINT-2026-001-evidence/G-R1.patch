diff --git a/react-app/src/components/Audit/Audit.print.css b/react-app/src/components/Audit/Audit.print.css
new file mode 100644
index 00000000..d1bdd28d
--- /dev/null
+++ b/react-app/src/components/Audit/Audit.print.css
@@ -0,0 +1,136 @@
+/* Audit printouts (AUDIT-PRINT-2026-001) — report / plan / checklist in the formal NCR-style layout, mirroring the
+   OSD/NCR print CSS. Portal-mounted into <body> (sibling of #root) and shown only while printing; every rule is scoped
+   under .audit-print-root so the generic table/td/th selectors never leak into the app. The masthead lives in the
+   outer table's <thead> so the browser repeats it on every printed page.
+
+   Unlike the other modules' print CSS, #root is hidden only while an Audit printout is mounted (body:has(...)), so this
+   file never blanks a plain browser print of another page. */
+
+:root {
+    --audit-ink: #1c1f24;
+    --audit-muted: #5b6068;
+    --audit-line: #9aa0a8;
+    --audit-line-soft: #c9ced4;
+    --audit-fill: #eef1f4;
+    --audit-fill-head: #dfe4ea;
+    --audit-accent: #0f766e;
+    --audit-status: #1f6f8b;
+    --audit-note: #7a818a;
+}
+
+.audit-print-root { display: none; }
+
+.audit-print-root {
+    font-family: "Noto Sans CJK TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
+    color: var(--audit-ink);
+    font-size: 9.3px;
+    line-height: 1.5;
+    background: #fff;
+}
+.audit-print-root * { box-sizing: border-box; }
+
+.audit-print-root .audit-report { width: 100%; border-collapse: collapse; }
+.audit-print-root .head-cell,
+.audit-print-root .body-cell { border: none; padding: 0; text-align: left; font-weight: 400; }
+
+.audit-print-root .doc-head {
+    display: flex; align-items: stretch;
+    border-bottom: 2.2px solid var(--audit-ink);
+    padding-bottom: 6px; margin-bottom: 10px;
+}
+.audit-print-root .logo-box {
+    width: 78px; min-height: 46px;
+    border: 1px dashed var(--audit-line-soft);
+    display: flex; align-items: center; justify-content: center;
+    color: #b8bdc4; font-size: 9px; letter-spacing: 1px;
+}
+.audit-print-root .head-mid { flex: 1; padding: 2px 14px; }
+.audit-print-root .head-mid .co { font-size: 14px; font-weight: 700; letter-spacing: .5px; }
+.audit-print-root .head-mid .sub { font-size: 9.5px; color: var(--audit-muted); margin-top: 2px; }
+.audit-print-root .head-right { text-align: right; font-size: 9px; line-height: 1.6; min-width: 120px; }
+.audit-print-root .head-right .docno { font-weight: 700; font-size: 10px; letter-spacing: .3px; }
+.audit-print-root .head-right .unsaved { color: #b45309; font-weight: 700; font-size: 8.4px; }
+
+.audit-print-root .badge {
+    display: inline-block; padding: 1px 7px; border-radius: 2px;
+    font-weight: 700; font-size: 8.6px; letter-spacing: .4px; color: #fff;
+}
+.audit-print-root .b-status { background: var(--audit-status); }
+
+.audit-print-root .title {
+    text-align: center; font-size: 16px; font-weight: 700;
+    letter-spacing: 3px; margin: 4px 0 12px;
+}
+.audit-print-root .title .en {
+    font-size: 9px; font-weight: 500; letter-spacing: 2px;
+    color: var(--audit-muted); display: block; margin-top: 2px;
+}
+
+.audit-print-root .sec-head {
+    background: var(--audit-fill-head);
+    border-left: 3px solid var(--audit-accent);
+    padding: 3px 9px; font-weight: 700; font-size: 10px;
+    letter-spacing: .5px; margin: 11px 0 0;
+}
+.audit-print-root .sec-head.sec-head-sub { margin-top: 6px; }
+.audit-print-root .sec-head .en { font-weight: 500; color: var(--audit-muted); font-size: 8.6px; letter-spacing: .5px; }
+
+/* label / value grids: fixed layout so the value columns split the width evenly */
+.audit-print-root table { width: 100%; table-layout: fixed; border-collapse: collapse; margin-top: -1px; }
+.audit-print-root td, .audit-print-root th { border: 1px solid var(--audit-line); padding: 3px 6px; vertical-align: top; }
+.audit-print-root .val { word-break: break-word; white-space: pre-wrap; min-height: 14px; }
+.audit-print-root td.lbl {
+    background: var(--audit-fill); font-weight: 600;
+    width: 96px; color: #2a2e34;
+}
+.audit-print-root td.lbl small,
+.audit-print-root .items th small { display: block; color: var(--audit-note); font-weight: 500; font-size: 7.6px; letter-spacing: .2px; }
+.audit-print-root .blank { color: #aeb3ba; }
+
+/* checklist items: narrow #, most of the width for the question (same proportions as the Word export) */
+.audit-print-root .items th { background: var(--audit-fill); font-weight: 600; text-align: left; }
+.audit-print-root .items td { white-space: pre-wrap; word-break: break-word; }
+.audit-print-root .items .c-n { width: 5%; text-align: center; }
+.audit-print-root .items .c-no { width: 10%; }
+.audit-print-root .items .c-q { width: 36%; }
+.audit-print-root .items .c-r { width: 13%; }
+.audit-print-root .items .c-m { width: 24%; }
+.audit-print-root .items .c-d { width: 12%; }
+.audit-print-root .items .clause { font-weight: 600; }
+.audit-print-root .checklist-items .c-q { width: 42%; }
+.audit-print-root .checklist-items .c-r { width: 17%; }
+.audit-print-root .checklist-items .c-m { width: 26%; }
+.audit-print-root .checklist-items td { height: 46px; }
+.audit-print-root .checklist-items .boxes { white-space: nowrap; font-size: 8.6px; line-height: 1.7; }
+
+.audit-print-root .field-box { border: 1px solid var(--audit-line); min-height: 34px; padding: 4px 6px; white-space: pre-wrap; word-break: break-word; }
+.audit-print-root .field-box.fb-tall { min-height: 70px; }
+.audit-print-root .guide { color: #aeb3ba; font-style: italic; }
+
+/* sign-off (mirrors the NCR/OSD reports) */
+.audit-print-root .sign-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: 4px; }
+.audit-print-root .sign-grid.three { grid-template-columns: 1fr 1fr 1fr; }
+.audit-print-root .sign-cell { border: 1px solid var(--audit-line); padding: 6px 8px 7px; }
+.audit-print-root .sign-cell .role { font-weight: 700; font-size: 9px; }
+.audit-print-root .sign-cell .role .en { color: var(--audit-muted); font-weight: 500; font-size: 7.6px; }
+.audit-print-root .sign-line { border-bottom: 1px solid var(--audit-ink); height: 24px; margin: 6px 0 4px; }
+.audit-print-root .sign-meta { display: flex; justify-content: space-between; font-size: 8px; color: var(--audit-muted); }
+.audit-print-root .sign-meta span { flex: 1; }
+
+/* keep rows / boxes intact across page breaks */
+.audit-print-root tr,
+.audit-print-root .sign-cell,
+.audit-print-root .field-box { break-inside: avoid; page-break-inside: avoid; }
+.audit-print-root .sec-head { break-after: avoid; page-break-after: avoid; }
+
+@media print {
+    @page { size: A4; margin: 13mm 12mm; }
+    body:has(> .audit-print-root) #root { display: none !important; }
+    .audit-print-root { display: block !important; }
+    .audit-print-root .audit-report > thead,
+    .audit-print-root .items > thead { display: table-header-group; }
+    .audit-print-root * {
+        -webkit-print-color-adjust: exact !important;
+        print-color-adjust: exact !important;
+    }
+}
diff --git a/react-app/src/components/Audit/AuditPrintTemplate.tsx b/react-app/src/components/Audit/AuditPrintTemplate.tsx
new file mode 100644
index 00000000..bfd2ac5c
--- /dev/null
+++ b/react-app/src/components/Audit/AuditPrintTemplate.tsx
@@ -0,0 +1,302 @@
+import React from 'react';
+import { val, SignCell, DASH } from '../Shared/PrintPrimitives';
+
+/**
+ * Audit printouts (AUDIT-PRINT-2026-001) — the formal NCR-style layout, portal-mounted into <body> so @media print can show
+ * it while #root is hidden (printing the wizard itself came out blank once another module's print CSS had been loaded,
+ * since those hide #root unconditionally). Styling lives in Audit.print.css, scoped under .audit-print-root.
+ *
+ * - report:    the same six sections, labels and values as the Word export (backend audit_service.export_docx) —
+ *              keep the two in step.
+ * - plan:      sections 1-3 of the report plus a plan sign-off.
+ * - checklist: audit identity plus the items with blank result / remarks columns, for use on site.
+ *
+ * Prints what is on screen (the wizard's current form), unlike the Word export, which reads the saved record; unsaved
+ * changes are flagged in the masthead.
+ */
+export type AuditPrintKind = 'report' | 'plan' | 'checklist';
+
+export interface AuditPrintData {
+    auditNo: string;
+    status: string;
+    title: string;
+    projectLabel: string;
+    contractor: string;
+    startDate: string;
+    endDate: string;
+    location: string;
+    projectDirector: string;
+    techLead: string;
+    leadAuditor: string;
+    supportAuditors: string;
+    auditCriteria: string;
+    scopeDescription: string;
+    selectedTemplates: unknown[];
+    customCheckItems: unknown[];
+    findings: string;
+}
+
+interface AuditPrintTemplateProps {
+    kind: AuditPrintKind;
+    data: AuditPrintData;
+    unsaved?: boolean;
+}
+
+const TITLES: Record<AuditPrintKind, [string, string]> = {
+    report: ['內部稽核報告', 'INTERNAL AUDIT REPORT'],
+    plan: ['內部稽核計畫', 'INTERNAL AUDIT PLAN'],
+    checklist: ['稽核查檢表', 'AUDIT CHECKLIST'],
+};
+// Same wording as the Word export (_STATUS_TEXT / _RESULT_TEXT in audit_service.py).
+const STATUS_TEXT: Record<string, string> = {
+    'Draft': '草稿 Draft', 'Planned': '計畫中 Planned', 'In Progress': '進行中 In Progress',
+    'Completed': '已完成 Completed', 'Closed': '已關閉 Closed', 'Void': '作廢 Void',
+};
+const RESULT_TEXT: Record<string, string> = { pass: '符合 Pass', fail: '不符合 Fail', pending: '注意／待改善 Attention' };
+
+type CheckItem = { no?: unknown; clause?: unknown; task?: unknown; status?: unknown; note?: unknown; updatedAt?: unknown };
+
+// Whitespace-only counts as empty, as in the Word export.
+const clean = (v: unknown): string | undefined => {
+    if (v === null || v === undefined) return undefined;
+    const s = String(v);
+    return s.trim() ? s : undefined;
+};
+
+const AuditPrintTemplate: React.FC<AuditPrintTemplateProps> = ({ kind, data, unsaved = false }) => {
+    const items = data.customCheckItems.filter((i): i is CheckItem => !!i && typeof i === 'object' && !Array.isArray(i));
+    const templates = data.selectedTemplates.filter((t): t is string => typeof t === 'string' && !!t.trim());
+    // Same counting as the wizard's statistics cards and the Word export: anything not pass / fail is pending.
+    const total = items.length;
+    const passed = items.filter(i => i.status === 'pass').length;
+    const failed = items.filter(i => i.status === 'fail').length;
+    const pending = total - passed - failed;
+    const progress = total === 0 ? 0 : Math.round(((total - pending) / total) * 100);
+    const resultText = (s: unknown) => RESULT_TEXT[typeof s === 'string' ? s : ''] || RESULT_TEXT.pending;
+    const [titleZh, titleEn] = TITLES[kind];
+
+    const infoSection = (
+        <>
+            <div className="sec-head">1. 稽核資訊 <span className="en">Audit Information</span></div>
+            <table>
+                <tbody>
+                    <tr>
+                        <td className="lbl">稽核編號<small>Audit No.</small></td><td className="val">{val(clean(data.auditNo))}</td>
+                        <td className="lbl">狀態<small>Status</small></td><td className="val">{val(STATUS_TEXT[data.status] || clean(data.status))}</td>
+                    </tr>
+                    <tr>
+                        <td className="lbl">稽核標題<small>Audit Title</small></td><td className="val" colSpan={3}>{val(clean(data.title))}</td>
+                    </tr>
+                    <tr>
+                        <td className="lbl">專案<small>Project</small></td><td className="val">{val(clean(data.projectLabel))}</td>
+                        <td className="lbl">受稽核廠商<small>Auditee / Contractor</small></td><td className="val">{val(clean(data.contractor))}</td>
+                    </tr>
+                    <tr>
+                        <td className="lbl">開始日期<small>Start Date</small></td><td className="val">{val(clean(data.startDate))}</td>
+                        <td className="lbl">結束日期<small>End Date</small></td><td className="val">{val(clean(data.endDate))}</td>
+                    </tr>
+                    <tr>
+                        <td className="lbl">稽核地點<small>Location</small></td><td className="val" colSpan={3}>{val(clean(data.location))}</td>
+                    </tr>
+                </tbody>
+            </table>
+        </>
+    );
+
+    const teamSection = (
+        <>
+            <div className="sec-head">2. 稽核團隊 <span className="en">Audit Team</span></div>
+            <table>
+                <tbody>
+                    <tr>
+                        <td className="lbl">專案經理<small>Project Director</small></td><td className="val">{val(clean(data.projectDirector))}</td>
+                        <td className="lbl">工作包／技術負責人<small>Package / Tech. Lead</small></td><td className="val">{val(clean(data.techLead))}</td>
+                    </tr>
+                    <tr>
+                        <td className="lbl">主任稽核員<small>Lead Auditor</small></td><td className="val">{val(clean(data.leadAuditor))}</td>
+                        <td className="lbl">協同稽核員<small>Support Auditor(s)</small></td><td className="val">{val(clean(data.supportAuditors))}</td>
+                    </tr>
+                </tbody>
+            </table>
+        </>
+    );
+
+    const scopeSection = (
+        <>
+            <div className="sec-head">3. 稽核範圍與準則 <span className="en">Scope &amp; Criteria</span></div>
+            <table>
+                <tbody>
+                    <tr>
+                        <td className="lbl">稽核準則<small>Audit Criteria</small></td><td className="val" colSpan={3}>{val(clean(data.auditCriteria))}</td>
+                    </tr>
+                    <tr>
+                        <td className="lbl">選用模板<small>Templates</small></td><td className="val" colSpan={3}>{val(clean(templates.join('、')))}</td>
+                    </tr>
+                </tbody>
+            </table>
+            <div className="sec-head sec-head-sub">3.1 範圍描述 <span className="en">Audit Scope</span></div>
+            <div className="field-box">{clean(data.scopeDescription) || <span className="guide">說明本次稽核涵蓋之部門、流程、作業與地點</span>}</div>
+        </>
+    );
+
+    return (
+        <div className="audit-print-root" data-print-kind={kind}>
+            <table className="audit-report">
+                <thead>
+                    <tr>
+                        <th className="head-cell">
+                            <div className="doc-head">
+                                <div className="logo-box">LOGO</div>
+                                <div className="head-mid">
+                                    <div className="co">［ 公司名稱 Company Name ］</div>
+                                    <div className="sub">品質管理 — 內部稽核 ｜ Quality Management — Internal Audit</div>
+                                </div>
+                                <div className="head-right">
+                                    <div className="docno">{clean(data.auditNo) || '(自動 auto)'}</div>
+                                    <div>狀態 <span className="badge b-status">{(data.status || '').toUpperCase() || DASH}</span></div>
+                                    {unsaved && <div className="unsaved">含未儲存的修改 Unsaved changes</div>}
+                                </div>
+                            </div>
+                            <div className="title">{titleZh}<span className="en">{titleEn}</span></div>
+                        </th>
+                    </tr>
+                </thead>
+                <tbody>
+                    <tr>
+                        <td className="body-cell">
+                            {kind === 'checklist' ? (
+                                <>
+                                    <div className="sec-head">1. 稽核資訊 <span className="en">Audit Information</span></div>
+                                    <table>
+                                        <tbody>
+                                            <tr>
+                                                <td className="lbl">稽核編號<small>Audit No.</small></td><td className="val">{val(clean(data.auditNo))}</td>
+                                                <td className="lbl">專案<small>Project</small></td><td className="val">{val(clean(data.projectLabel))}</td>
+                                            </tr>
+                                            <tr>
+                                                <td className="lbl">受稽核廠商<small>Auditee / Contractor</small></td><td className="val">{val(clean(data.contractor))}</td>
+                                                <td className="lbl">稽核地點<small>Location</small></td><td className="val">{val(clean(data.location))}</td>
+                                            </tr>
+                                            <tr>
+                                                <td className="lbl">稽核日期<small>Audit Date</small></td>
+                                                <td className="val">{val([clean(data.startDate), clean(data.endDate)].filter(Boolean).join(' ~ ') || undefined)}</td>
+                                                <td className="lbl">主任稽核員<small>Lead Auditor</small></td><td className="val">{val(clean(data.leadAuditor))}</td>
+                                            </tr>
+                                        </tbody>
+                                    </table>
+                                    <div className="sec-head">2. 查檢項目 <span className="en">Audit Items</span></div>
+                                    {items.length > 0 ? (
+                                        <table className="items checklist-items">
+                                            <thead>
+                                                <tr>
+                                                    <th className="c-n">#</th><th className="c-no">條文編號<small>Clause No.</small></th>
+                                                    <th className="c-q">條文與查檢重點<small>Clause &amp; Audit Question</small></th>
+                                                    <th className="c-r">結果<small>Result</small></th><th className="c-m">備註<small>Remarks</small></th>
+                                                </tr>
+                                            </thead>
+                                            <tbody>
+                                                {items.map((item, n) => (
+                                                    <tr key={n}>
+                                                        <td className="c-n">{n + 1}</td>
+                                                        <td className="c-no">{clean(item.no) || DASH}</td>
+                                                        <td className="c-q">
+                                                            {clean(item.clause) && <div className="clause">{clean(item.clause)}</div>}
+                                                            <div>{clean(item.task) || DASH}</div>
+                                                        </td>
+                                                        <td className="c-r boxes"><div>☐ 符合 Pass</div><div>☐ 不符合 Fail</div><div>☐ 注意 Attention</div></td>
+                                                        <td className="c-m" />
+                                                    </tr>
+                                                ))}
+                                            </tbody>
+                                        </table>
+                                    ) : (
+                                        <div className="field-box"><span className="guide">（尚無查檢項目 No audit items）</span></div>
+                                    )}
+                                    <div className="sec-head">3. 簽核 <span className="en">Sign-off</span></div>
+                                    <div className="sign-grid">
+                                        <SignCell num="3.1" zh="主任稽核員" en="Lead Auditor" name={clean(data.leadAuditor)} />
+                                        <SignCell num="3.2" zh="受稽核方代表" en="Auditee Representative" />
+                                    </div>
+                                </>
+                            ) : (
+                                <>
+                                    {infoSection}
+                                    {teamSection}
+                                    {scopeSection}
+                                    {kind === 'report' ? (
+                                        <>
+                                            <div className="sec-head">4. 查檢結果 <span className="en">Checklist Results</span></div>
+                                            <table>
+                                                <tbody>
+                                                    <tr>
+                                                        <td className="lbl">查檢項目數<small>Total Items</small></td><td className="val">{total}</td>
+                                                        <td className="lbl">完成率<small>Progress</small></td><td className="val">{progress}%</td>
+                                                    </tr>
+                                                    <tr>
+                                                        <td className="lbl">符合<small>Pass</small></td><td className="val">{passed}</td>
+                                                        <td className="lbl">不符合<small>Fail</small></td><td className="val">{failed}</td>
+                                                    </tr>
+                                                    <tr>
+                                                        <td className="lbl">注意／待改善<small>Attention / Pending</small></td><td className="val" colSpan={3}>{pending}</td>
+                                                    </tr>
+                                                </tbody>
+                                            </table>
+                                            <div className="sec-head sec-head-sub">4.1 查檢明細 <span className="en">Audit Items</span></div>
+                                            {items.length > 0 ? (
+                                                <table className="items">
+                                                    <thead>
+                                                        <tr>
+                                                            <th className="c-n">#</th><th className="c-no">條文編號<small>Clause No.</small></th>
+                                                            <th className="c-q">條文與查檢重點<small>Clause &amp; Audit Question</small></th>
+                                                            <th className="c-r">結果<small>Result</small></th><th className="c-m">備註<small>Remarks</small></th>
+                                                            <th className="c-d">更新日期<small>Updated</small></th>
+                                                        </tr>
+                                                    </thead>
+                                                    <tbody>
+                                                        {items.map((item, n) => (
+                                                            <tr key={n}>
+                                                                <td className="c-n">{n + 1}</td>
+                                                                <td className="c-no">{clean(item.no) || DASH}</td>
+                                                                <td className="c-q">
+                                                                    {clean(item.clause) && <div className="clause">{clean(item.clause)}</div>}
+                                                                    <div>{clean(item.task) || DASH}</div>
+                                                                </td>
+                                                                <td className="c-r">{resultText(item.status)}</td>
+                                                                <td className="c-m">{clean(item.note) || DASH}</td>
+                                                                <td className="c-d">{clean(item.updatedAt) || DASH}</td>
+                                                            </tr>
+                                                        ))}
+                                                    </tbody>
+                                                </table>
+                                            ) : (
+                                                <div className="field-box"><span className="guide">（尚無查檢項目 No audit items）</span></div>
+                                            )}
+                                            <div className="sec-head">5. 稽核發現與總結 <span className="en">Findings &amp; Summary</span></div>
+                                            <div className="field-box fb-tall">{clean(data.findings) || <span className="guide">記錄稽核發現、不符合事項與總結</span>}</div>
+                                            <div className="sec-head">6. 簽核 <span className="en">Sign-off</span></div>
+                                            <div className="sign-grid three">
+                                                <SignCell num="6.1" zh="主任稽核員" en="Lead Auditor" name={clean(data.leadAuditor)} />
+                                                <SignCell num="6.2" zh="受稽核方代表" en="Auditee Representative" />
+                                                <SignCell num="6.3" zh="專案經理" en="Project Director" name={clean(data.projectDirector)} />
+                                            </div>
