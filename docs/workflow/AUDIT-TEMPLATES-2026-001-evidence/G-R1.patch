+"""
+Audit template library (AUDIT-TEMPLATES-2026-001).
+
+A template is a named list of check items ({id, no, clause, task}). The wizard COPIES a selected template's items into
+the audit's custom_check_items, so nothing here ever reaches into an existing audit: editing or deactivating a template
+changes only what later selections copy. Templates are never hard-deleted (audits keep the name in selected_templates);
+is_active=False hides one from the wizard.
+
+Initial templates: the four names the wizard used to hard-code. ISO 9001:2015 starts with the wizard's 20 built-in ISO
+clauses; the other three start empty for the user to fill in on the template management tab. They are written once by
+db_migrations step 24 (flag audit_templates_initial_v1) and are ordinary rows after that.
+"""
+import json
+import uuid
+from datetime import datetime, timezone
+
+from sqlalchemy import func
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import Session
+
+import models
+import schemas
+
+
+class AuditTemplateConflict(Exception):
+    """Another template already has this name (compared trimmed, case-insensitively)."""
+
+
+# The wizard's built-in ISO 9001:2015 clause list (AuditWizard.tsx ISO_CLAUSES), with fixed item ids so the seeded rows
+# are the same on every database.
+ISO_9001_CLAUSES = [
+    ("4.1", "Understanding the organization and its context", "How has the organization determined external and internal issues relevant to its purpose and strategic direction?"),
+    ("4.2", "Understanding the needs and expectations of interested parties", "How do you monitor and review information about these interested parties and their relevant requirements?"),
+    ("4.3", "Determining the scope of the quality management system", "Has the organization determined the boundaries and applicability of the QMS to establish its scope?"),
+    ("4.4", "Quality management system and its processes", "How has the organization determined the processes needed for the QMS and their application?"),
+    ("5.1", "Leadership and commitment", "How does top management demonstrate leadership and commitment with respect to the QMS?"),
+    ("5.2", "Policy", "Has top management established, implemented and maintained a quality policy?"),
+    ("6.1", "Actions to address risks and opportunities", "How are risks and opportunities determined and addressed?"),
+    ("6.2", "Quality objectives and planning to achieve them", "Are quality objectives established at relevant functions, levels and processes?"),
+    ("7.1", "Resources", "How does the organization determine and provide the resources needed for the QMS?"),
+    ("7.2", "Competence", "How do you determine the necessary competence of person(s) doing work under your control?"),
+    ("7.5", "Documented information", "Does the QMS include documented information required by ISO 9001?"),
+    ("8.1", "Operational planning and control", "How does the organization plan, implement and control the processes needed to meet requirements?"),
+    ("8.2", "Requirements for products and services", "How do you determine the requirements for the products and services to be offered?"),
+    ("8.4", "Control of externally provided processes, products and services", "How do you ensure that externally provided processes, products and services conform to requirements?"),
+    ("8.5", "Production and service provision", "Are production and service provision implemented under controlled conditions?"),
+    ("9.1", "Monitoring, measurement, analysis and evaluation", "How do you determine what needs to be monitored and measured?"),
+    ("9.2", "Internal audit", "Are internal audits conducted at planned intervals?"),
+    ("9.3", "Management review", "Does top management review the organization's QMS at planned intervals?"),
+    ("10.2", "Nonconformity and corrective action", "When a nonconformity occurs, how does the organization react to it?"),
+    ("10.3", "Continual improvement", "How does the organization continually improve the QMS?"),
+]
+
+INITIAL_AUDIT_TEMPLATES = [
+    {"name": "ISO 9001:2015", "version": "2015",
+     "items": [{"id": f"iso9001-{no}", "no": no, "clause": clause, "task": task} for no, clause, task in ISO_9001_CLAUSES]},
+    {"name": "ISO 45001", "version": "", "items": []},
+    {"name": "品質管理程序書", "version": "", "items": []},
+    {"name": "供應商評鑑表", "version": "", "items": []},
+]
+
+
+def _now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _items_json(items):
+    """Dump items, giving every item without an id a fresh one. An id the request repeats on two items is replaced on
+    the second, so templateItemId stays unique inside a template."""
+    seen, out = set(), []
+    for it in items:
+        d = it.model_dump()
+        if not d.get("id") or d["id"] in seen:
+            d["id"] = uuid.uuid4().hex
+        seen.add(d["id"])
+        out.append({"id": d["id"], "no": d["no"], "clause": d["clause"], "task": d["task"]})
+    return json.dumps(out, ensure_ascii=False)
+
+
+class AuditTemplateService:
+    def __init__(self, db: Session):
+        self.db = db
+
+    def list_templates(self, include_inactive: bool = False):
+        q = self.db.query(models.AuditTemplate)
+        if not include_inactive:
+            q = q.filter(models.AuditTemplate.is_active.is_(True))
+        return q.order_by(models.AuditTemplate.id).all()
+
+    def _check_name_free(self, name, exclude_id=None):
+        q = self.db.query(models.AuditTemplate).filter(func.lower(func.trim(models.AuditTemplate.name)) == name.strip().lower())
+        if exclude_id is not None:
+            q = q.filter(models.AuditTemplate.id != exclude_id)
+        if q.first():
+            raise AuditTemplateConflict(f"A template named '{name}' already exists.")
+
+    def _log(self, action, tpl, old, new, user_id, username):
+        self.db.add(models.AuditLog(
+            timestamp=datetime.now().isoformat(), action=action, entity_type="AuditTemplate", entity_id=str(tpl.id),
+            entity_name=tpl.name, old_value=json.dumps(old, ensure_ascii=False) if old else None,
+            new_value=json.dumps(new, ensure_ascii=False) if new else None, user_id=user_id, username=username))
+
+    def _commit(self, name):
+        try:
+            self.db.commit()
+        except IntegrityError:  # a concurrent save took the name between the check and the commit (unique index)
+            self.db.rollback()
+            raise AuditTemplateConflict(f"A template named '{name}' already exists.")
+
+    @staticmethod
+    def _snapshot(tpl):
+        return {"name": tpl.name, "description": tpl.description, "version": tpl.version, "is_active": tpl.is_active,
+                "items": json.loads(tpl.items or "[]")}
+
+    def create_template(self, data: schemas.AuditTemplateCreate, user_id=None, username=None):
+        self._check_name_free(data.name)
+        now = _now()
+        tpl = models.AuditTemplate(name=data.name, description=data.description or "", version=data.version or "",
+                                   is_active=data.is_active, items=_items_json(data.items), created_at=now, updated_at=now)
+        self.db.add(tpl)
+        self.db.flush()
+        self._log("CREATE", tpl, None, self._snapshot(tpl), user_id, username)
+        self._commit(data.name)
+        self.db.refresh(tpl)
+        return tpl
+
+    def update_template(self, template_id: int, data: schemas.AuditTemplateUpdate, user_id=None, username=None):
+        tpl = self.db.get(models.AuditTemplate, template_id)
+        if tpl is None:
+            return None
+        old = self._snapshot(tpl)
+        fields = data.model_dump(exclude_unset=True)
+        if fields.get("name") is not None:
+            self._check_name_free(fields["name"], exclude_id=tpl.id)
+            tpl.name = fields["name"]
+        if "description" in fields:
+            tpl.description = fields["description"] or ""
+        if "version" in fields:
+            tpl.version = fields["version"] or ""
+        if fields.get("is_active") is not None:
+            tpl.is_active = fields["is_active"]
+        if data.items is not None:
+            tpl.items = _items_json(data.items)
+        new = self._snapshot(tpl)
+        if new == old:
+            return tpl
+        tpl.updated_at = _now()
+        self._log("UPDATE", tpl, old, new, user_id, username)
+        self._commit(tpl.name)
+        self.db.refresh(tpl)
+        return tpl
