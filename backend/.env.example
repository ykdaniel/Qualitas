# ==========================================
# Qualitas Backend 環境變數配置範例
# ==========================================
# 複製此檔案為 .env 並填入實際值
# 注意：請勿將 .env 提交至版本控制

# ==========================================
# 環境設定
# ==========================================
# 環境類型：development, staging, production
ENVIRONMENT=development

# 日誌設定
LOG_LEVEL=INFO
LOG_DIR=logs

# ==========================================
# 安全設定（JWT）
# ==========================================
# JWT 密鑰（生產環境請使用強度足夠的隨機密鑰）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-strong-secret-key-change-in-production

# JWT 演算法
ALGORITHM=HS256

# JWT Token 過期時間（分鐘）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# 資料庫設定
# ==========================================
# SQLite (開發環境)
DATABASE_URL=sqlite:///./qualitas.db

# PostgreSQL (生產環境範例)
# DATABASE_URL=postgresql://user:password@localhost:5432/qualitas_db

# 資料庫連接池大小（僅適用於 PostgreSQL/MySQL）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================================
# CORS 設定
# ==========================================
# 允許的來源網址（多個用逗號分隔）
# 開發環境
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# 生產環境範例
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==========================================
# 郵件服務設定（用於通知功能）
# ==========================================
# SMTP 伺服器設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# 寄件者名稱
SMTP_FROM=noreply@qualitas-erp.com

# 如未設定 SMTP，系統將以 Mock 模式運行（僅記錄日誌，不實際發送）

# ==========================================
# API 速率限制
# ==========================================
RATE_LIMIT_PER_MINUTE=60

# ==========================================
# 檔案上傳設定
# ==========================================
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# ==========================================
# 其他設定
# ==========================================
# 時區
TIMEZONE=Asia/Taipei

# 調試模式（開發環境可設為 true）
DEBUG=false
